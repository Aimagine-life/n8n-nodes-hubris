{
	"name": "n8n-nodes-hubris",
	"version": "0.1.1",
	"publishConfig": { "access": "public" },
	"description": "n8n nodes for Hubris — one API key for Claude, GPT, Gemini, DeepSeek and 400+ models: chat, images, audio, video, embeddings",
	"license": "MIT",
	"homepage": "https://hubris.pw/docs/integrations/n8n",
	"keywords": ["n8n-community-node-package", "n8n", "hubris", "llm", "openai", "claude", "gemini", "ai"],
	"author": { "name": "Hubris", "email": "support@hubris.pw" },
	"repository": { "type": "git", "url": "https://github.com/Aimagine-life/n8n-nodes-hubris.git" },
	"engines": { "node": ">=22" },
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": ["dist"],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"credentials": ["dist/credentials/HubrisApi.credentials.js"],
		"nodes": ["dist/nodes/Hubris/Hubris.node.js", "dist/nodes/LmChatHubris/LmChatHubris.node.js"]
	},
	"devDependencies": {
		"@n8n/ai-node-sdk": "*",
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"n8n-workflow": "*",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "^3.2.0"
	},
	"peerDependencies": { "n8n-workflow": "*", "@n8n/ai-node-sdk": "*" }
}
